<Window x:Class="p0_wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="p0-wpf"
        Width="400" Height="120"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual" Left="120" Top="120">
    <!-- Tauri tarafiyla ayni plaka: opak taban, ayni olculer, her karede
         degisen bir eleman. Bos bir pencere olcumu iyimser gosterir. -->
    <Border BorderThickness="1" BorderBrush="#2AA9BC">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF071016" Offset="0"/>
                <GradientStop Color="#FF04090C" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Column="0">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF112233" Offset="0"/>
                        <GradientStop Color="#FF4FE9F7" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                <TextBlock Text="P0 GECIKME KAPISI" Foreground="#FF7DA3AE"
                           FontFamily="Consolas" FontSize="11"/>
                <TextBlock x:Name="Counter" Text="—" Foreground="#FFE8F8FB"
                           FontFamily="Consolas" FontSize="17" Margin="0,4,0,0"/>
                <Grid Height="6" Margin="0,10,0,0" Background="#FF12242B">
                    <Rectangle x:Name="Fill" Fill="#FF4FE9F7"
                               HorizontalAlignment="Left" Width="30"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
